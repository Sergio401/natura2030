# Admin access. Use a unique password and a random SESSION_SECRET of at least 32 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-a-long-random-secret

# OpenAI credentials are read only on the server and must never use a PUBLIC_ prefix.
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-5.4-mini

# --- VPS-only: dev preview + change-request agent ---------------------------
# Not needed for local dev or the Vercel deploy. These matter only on the
# self-hosted VPS; see DEPLOY.md and docs/AGENT_CONTRACT.md for the full
# pipeline. Defaults below match the contract; uncomment to override.

# Set on the `natura-dev` pm2 process only (never on `natura`): shows the red
# "development version, not published yet" banner in BaseLayout.
# DEPLOY_ENV=dev

# The natura-agent worker (agent/worker.mjs, pm2 app `natura-agent`) reads
# these instead of this .env file — they're set in ecosystem.config.cjs, but
# listed here for reference. All have defaults; only override if you're
# deviating from the standard VPS layout.
# AGENT_DATA_DIR=$HOME/natura-agent
# AGENT_PROD_DIR=$HOME/code/natura2030
# AGENT_DEV_DIR=$HOME/code/natura2030-dev
# AGENT_PROD_BRANCH=main       # use `chatbot` until that branch merges into main
# AGENT_DEV_BRANCH=dev
# AGENT_DEV_URL=https://dev.natura.2-25-153-144.sslip.io
# AGENT_CLAUDE_MODEL=sonnet
# AGENT_CLAUDE_TIMEOUT_MS=900000
# AGENT_MAX_FIX_ROUNDS=1
# AGENT_GIT_PUSH=true

