---
interface Props {
  labelToLight: string;
  labelToDark: string;
}
const { labelToLight, labelToDark } = Astro.props;
---

<button
  type="button"
  class="natura-theme-toggle"
  data-natura-theme-toggle
  data-label-light={labelToLight}
  data-label-dark={labelToDark}
  aria-label={labelToDark}
>
  <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" />
    <path d="M12 2.5v2.4M12 19.1v2.4M4.2 4.2l1.7 1.7M18.1 18.1l1.7 1.7M2.5 12h2.4M19.1 12h2.4M4.2 19.8l1.7-1.7M18.1 5.9l1.7-1.7" stroke-linecap="round" />
  </svg>
  <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.8 6.8 0 0 0 10.5 10.5Z" stroke-linejoin="round" />
  </svg>
</button>

<style>
  .natura-theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 999px;
    border: 1px solid currentColor;
    opacity: 0.7;
    background: transparent;
    color: inherit;
    cursor: pointer;
    transition: opacity 0.2s ease, transform 0.2s ease;
    flex: none;
  }
  .natura-theme-toggle:hover {
    opacity: 1;
  }
  .natura-theme-toggle svg {
    width: 18px;
    height: 18px;
  }
  .icon-moon {
    display: none;
  }
  :global([data-theme='dark']) .natura-theme-toggle .icon-sun {
    display: none;
  }
  :global([data-theme='dark']) .natura-theme-toggle .icon-moon {
    display: block;
  }
</style>

<script is:inline>
  document.querySelectorAll('[data-natura-theme-toggle]').forEach((btn) => {
    const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
    btn.setAttribute('aria-label', isDark ? btn.getAttribute('data-label-light') : btn.getAttribute('data-label-dark'));
  });
  document.addEventListener('click', (e) => {
    const btn = e.target instanceof Element ? e.target.closest('[data-natura-theme-toggle]') : null;
    if (!btn) return;
    const root = document.documentElement;
    const current = root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    const applyTheme = () => {
      root.setAttribute('data-theme', next);
      try {
        localStorage.setItem('natura-theme', next);
      } catch (err) {}
      btn.setAttribute('aria-label', next === 'dark' ? btn.getAttribute('data-label-light') : btn.getAttribute('data-label-dark'));
    };
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced || !document.startViewTransition) {
      applyTheme();
    } else {
      document.startViewTransition(applyTheme);
    }
  });
</script>
