---
import { pathFor, versions } from '../../utils/routes';
import type { Version } from '../../utils/routes';
import type { Locale } from '../../data/types';

interface Props {
  version: Version;
  locale: Locale;
  label: string;
  names: Record<Version, string>;
}
const { version, locale, label, names } = Astro.props;
---

<nav class="natura-version-switcher" aria-label={label}>
  <span class="natura-version-switcher__label">{label}</span>
  {
    versions.map((v) => (
      <a href={pathFor(v, locale)} aria-current={v === version ? 'page' : undefined}>
        {v.toUpperCase()} · {names[v]}
      </a>
    ))
  }
</nav>

<style>
  .natura-version-switcher {
    position: fixed;
    left: 50%;
    bottom: 18px;
    transform: translateX(-50%);
    z-index: 60;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px;
    border-radius: 999px;
    background: rgba(10, 12, 16, 0.82);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    font-family: Arial, Helvetica, sans-serif;
  }
  .natura-version-switcher__label {
    color: rgba(255, 255, 255, 0.45);
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0 8px;
    display: none;
  }
  .natura-version-switcher a {
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    font-size: 12px;
    font-weight: 700;
    padding: 8px 12px;
    border-radius: 999px;
    white-space: nowrap;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .natura-version-switcher a:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
  .natura-version-switcher a[aria-current='page'] {
    background: #35c3bb;
    color: #0c1b33;
  }
  @media (min-width: 640px) {
    .natura-version-switcher__label {
      display: inline-block;
    }
  }
  @media (max-width: 560px) {
    .natura-version-switcher {
      left: 12px;
      right: 12px;
      bottom: 12px;
      transform: none;
      justify-content: center;
      flex-wrap: wrap;
    }
    .natura-version-switcher a {
      padding: 8px 10px;
      font-size: 11px;
    }
  }
</style>
