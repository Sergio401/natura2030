---
import '@fontsource/archivo/400.css';
import '@fontsource/archivo/600.css';
import '@fontsource/archivo/700.css';
import '@fontsource/archivo/800.css';
import '@fontsource/archivo/900.css';
import type { Locale } from '../data/types';

interface Props {
  lang: Locale;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;

// Read at request time (not import.meta.env): the same code runs on both the
// `natura` (prod) and `natura-dev` (dev) pm2 processes, and only the dev
// process sets DEPLOY_ENV=dev in its environment. See docs/AGENT_CONTRACT.md.
const showDevBanner = process.env.DEPLOY_ENV === 'dev';
const devBannerText = lang === 'en'
  ? 'Development version. These changes are not published yet.'
  : 'Versión de desarrollo. Estos cambios todavía no están publicados.';
---

<!doctype html>
<html lang={lang} class:list={[showDevBanner && 'has-dev-banner']}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('natura-theme');
          var theme = stored === 'light' || stored === 'dark'
            ? stored
            : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    {showDevBanner && <div class="dev-banner" role="status">{devBannerText}</div>}
    <a class="skip-link" href="#main"><slot name="skip-label">Skip to content</slot></a>
    <slot />
  </body>
</html>

<style is:global>
  /*
    Horizontal-scroll guard lives on html/body (the real root scroller), not on
    the page wrapper. Setting overflow-x on a nested element makes the
    browser treat it as its own scroll container (overflow-y auto-computes),
    which breaks `position: sticky` for every descendant, including the nav bar.
  */
  html {
    overflow-x: hidden;
    scroll-behavior: smooth;
    --dev-banner-h: 0px;
  }
  html.has-dev-banner {
    --dev-banner-h: 40px;
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
  body {
    margin: 0;
    padding-top: var(--dev-banner-h);
  }
  .dev-banner {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 9999;
    min-height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px 16px;
    background: #c0202a;
    color: #ffffff;
    font-family: Arial, sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    text-align: center;
    line-height: 1.35;
  }
  @media (max-width: 480px) {
    html.has-dev-banner {
      --dev-banner-h: 56px;
    }
    .dev-banner {
      min-height: 56px;
    }
  }
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: #fff;
    color: #000;
    padding: 12px 20px;
    border-radius: 0 0 8px 0;
    font-family: Arial, sans-serif;
    font-weight: 700;
  }
  .skip-link:focus {
    left: 0;
  }

  /*
    Dark-mode toggle transition: a diagonal clip-path wipe driven by the
    View Transitions API (theme-toggle.rdsx.dev's "polygon" technique).
    Unsupported browsers (Firefox, older Safari) just get an instant swap —
    `document.startViewTransition` is feature-detected in ThemeToggle.astro,
    so nothing here is required for the toggle to keep working.
  */
  @media (prefers-reduced-motion: no-preference) {
    ::view-transition-group(root) {
      animation-duration: 0.7s;
      animation-timing-function: cubic-bezier(0.65, 0, 0.35, 1);
    }
    ::view-transition-new(root) {
      animation-name: natura-reveal-light;
      animation-fill-mode: both;
    }
    ::view-transition-old(root),
    :root[data-theme='dark']::view-transition-old(root) {
      animation: none;
      animation-fill-mode: both;
      z-index: -1;
    }
    :root[data-theme='dark']::view-transition-new(root) {
      animation-name: natura-reveal-dark;
      animation-fill-mode: both;
    }
    @keyframes natura-reveal-dark {
      from {
        clip-path: polygon(50% -71%, -50% 71%, -50% 71%, 50% -71%);
      }
      to {
        clip-path: polygon(50% -71%, -50% 71%, 50% 171%, 171% 50%);
      }
    }
    @keyframes natura-reveal-light {
      from {
        clip-path: polygon(171% 50%, 50% 171%, 50% 171%, 171% 50%);
      }
      to {
        clip-path: polygon(171% 50%, 50% 171%, -50% 71%, 50% -71%);
      }
    }
  }
</style>
