---
import { Image } from 'astro:assets';
import isotipoColor from '../../assets/brand/isotipo-color.png';
import ThemeToggle from '../../components/shared/ThemeToggle.astro';
import LanguageSwitcher from '../../components/shared/LanguageSwitcher.astro';
import VersionSwitcher from '../../components/shared/VersionSwitcher.astro';
import ContactEmail from '../../components/shared/ContactEmail.astro';
import { getContent } from '../../data';
import type { Locale } from '../../data/types';
import { parseHeadline } from '../../utils/headline';
import './tokens.css';
import { v3Copy } from './copy';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
const c = v3Copy[locale];
const headlineLines = parseHeadline(c.hero.headline);
const ringRadii = [112, 96, 80, 64];
---

<div class="theme-v3" id="main">
  <header class="co-nav" data-natura-nav>
    <div class="co-brand">
      <Image src={isotipoColor} alt="Adaptation Latin America" width={32} height={32} />
      <span class="word">{t.meta.orgName.toUpperCase()}</span>
    </div>
    <div class="co-nav-tools">
      <LanguageSwitcher version="v3" locale={locale} label={t.ui.languageLabel} />
      <ThemeToggle labelToLight={t.ui.themeToggleToLight} labelToDark={t.ui.themeToggleToDark} />
      <a href="#" class="co-btn co-btn-ghost">{t.cta.initiatives}</a>
      <a href="#" class="co-btn co-btn-primary">{t.cta.models}</a>
    </div>
  </header>

  <section class="co-hero">
    <span class="co-eyebrow">{c.hero.eyebrow}</span>
    <h1>
      {headlineLines.map((line, li) => (
        <>
          {line.map((w) => (
            <>
              {w.spaceBefore && ' '}
              <span class:list={[{ accent: w.accent }]}>{w.text}</span>
            </>
          ))}
          {li < headlineLines.length - 1 && <br />}
        </>
      ))}
    </h1>
    <p class="lede">{c.hero.lede}</p>
    <div class="co-hero-cta">
      <a href="#" class="co-btn co-btn-ghost">{t.cta.initiatives}</a>
      <a href="#" class="co-btn co-btn-primary magnetic">{t.cta.models}</a>
    </div>
    <div class="co-coast" data-draw-trigger aria-hidden="true">
      <svg viewBox="0 0 1100 180" fill="none">
        <path class="co-coast-path" pathLength="1000" d="M10 90C90 40 150 150 230 100C310 50 360 140 440 90C520 40 580 150 660 100C740 50 800 140 880 95C940 62 990 100 1090 70"></path>
      </svg>
      <div class="co-signal" style="top:22%; left:20%;"></div>
      <div class="co-signal" style="top:70%; left:42%;"></div>
      <div class="co-signal" style="top:30%; left:63%;"></div>
      <div class="co-signal" style="top:60%; left:84%;"></div>
    </div>
  </section>

  <section class="co-section" id="entradas">
    <div class="co-wrap">
      <div class="co-head">
        <span class="co-eyebrow">{c.sections.inputs.eyebrow}</span>
        <h2>{c.sections.inputs.title}</h2>
      </div>
      <div class="co-scrolly">
        <div class="co-sticky">
          <div class="co-mark-ring">
            <svg viewBox="0 0 230 230" aria-hidden="true">
              {ringRadii.map((r, i) => <circle class="ring" data-ring={i} cx="115" cy="115" r={r}></circle>)}
            </svg>
            <Image src={isotipoColor} alt="" width={104} height={104} />
          </div>
          <div class="co-caption">
            {t.inputs.items.map((item, i) => (
              <span class="cap" data-cap={i}>{item.title}</span>
            ))}
          </div>
        </div>
        <div class="co-chapters">
          {t.inputs.items.map((item, i) => (
            <div class="co-chapter" data-chapter={i}>
              <span class="idx">{String(i + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="co-section" id="proceso" style="padding-top:0;">
    <div class="co-wrap">
      <div class="co-head">
        <span class="co-eyebrow">{c.sections.process.eyebrow}</span>
        <h2>{c.sections.process.title}</h2>
      </div>
      <div class="co-process stagger">
        {t.process.steps.map((step) => (
          <div class="co-pstep reveal"><b>{`${step.n} · ${step.title}`}</b><p>{step.body}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="co-section">
    <div class="co-wrap">
      <div class="co-head">
        <span class="co-eyebrow">{c.sections.deliverables.eyebrow}</span>
        <h2>{c.sections.deliverables.title}</h2>
      </div>
      <div class="co-deliver-grid stagger">
        {t.deliverables.items.map((item) => (
          <div class="co-deliver-card reveal"><span class="tag">{item.tag}</span><h3>{item.title}</h3><p>{item.body}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="co-section" id="aplicaciones">
    <div class="co-wrap">
      <div class="co-head">
        <span class="co-eyebrow">{c.sections.applications.eyebrow}</span>
        <h2>{c.sections.applications.title}</h2>
      </div>
      <div class="co-pins">
        {t.applications.items.map((label) => (
          <div class="co-pin">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 21s7-6.5 7-12a7 7 0 0 0-14 0c0 5.5 7 12 7 12Z"></path><circle cx="12" cy="9" r="2.4"></circle></svg>
            <span>{label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="co-section" id="nosotros">
    <div class="co-wrap co-about">
      <div>
        <span class="co-eyebrow">{c.sections.about.eyebrow}</span>
        <h2>{c.sections.about.title}</h2>
        <p>{t.about.body}</p>
        <div class="co-pillars">
          {t.about.pillars.map((p) => <div class="co-pillar"><span>{p}</span></div>)}
        </div>
      </div>
      <div class="co-map2" aria-hidden="true"><Image src={isotipoColor} alt="" width={220} height={220} /></div>
    </div>
  </section>

  <section class="co-cta" id="cta">
    <div class="co-cta-inner">
      <div class="co-cta-copy">
        <span class="co-eyebrow" style="color:var(--ink);">{c.sections.cta.eyebrow}</span>
        <h2>{c.sections.cta.title}</h2>
      </div>
      <ContactEmail email={t.footer.email} copyLabel={t.ui.copyEmail} copiedLabel={t.ui.emailCopied} />
    </div>
  </section>

  <footer class="co-footer">
    <div class="co-footer-top">
      <div class="co-footer-brand"><Image src={isotipoColor} alt="" width={26} height={26} /><span>{t.meta.orgName}</span></div>
      <div class="co-footer-links">
        <a href={`mailto:${t.footer.email}`}>{t.footer.email}</a>
      </div>
    </div>
    <div class="co-footer-bottom">
      <span>{t.footer.copyright}</span>
      <span>{t.footer.note}</span>
    </div>
  </footer>

  <VersionSwitcher version="v3" locale={locale} label={t.ui.versionLabel} names={t.ui.versionNames} />
</div>

<style>
  .theme-v3 {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: var(--ink);
    background: linear-gradient(180deg, var(--bg-1) 0%, var(--bg-2) 45%, var(--bg-1) 100%);
    width: 100%;
    position: relative;
  }
  .theme-v3 * { box-sizing: border-box; }
  .theme-v3 h1, .theme-v3 h2, .theme-v3 h3 { font-family: 'Archivo', Arial, sans-serif; font-weight: 900; margin: 0; letter-spacing: -0.01em; }
  .theme-v3 p { margin: 0; line-height: 1.62; }
  .theme-v3 a:not(.co-btn) { color: var(--ink); text-decoration: none; }
  .theme-v3 a:not(.co-btn):hover { color: var(--teal); }
  .co-eyebrow { font-family: 'Archivo', sans-serif; font-weight: 800; font-size: 12.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--teal); }
  .co-wrap { max-width: 1180px; margin: 0 auto; padding: 0 48px; }

  .co-nav { position: sticky; top: 0; z-index: 40; display: flex; align-items: center; justify-content: space-between;
    padding: 16px 48px; background: transparent;
    transition: background .3s ease, backdrop-filter .3s ease; }
  .co-nav.scrolled { background: color-mix(in srgb, var(--bg-1) 45%, transparent); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); }
  .co-brand { display: flex; align-items: center; gap: 10px; }
  .co-brand .word { font-family: 'Archivo',sans-serif; font-weight: 900; font-size: 14.5px; line-height: 1.1; }
  .co-nav-tools { display: flex; align-items: center; gap: 16px; }
  .co-btn { font-family: 'Archivo',sans-serif; font-weight: 800; font-size: 14px; border-radius: 999px; padding: 13px 26px;
    display: inline-flex; align-items: center; gap: 8px; border: 2px solid transparent; cursor: pointer; text-decoration: none;
    transition: transform .35s cubic-bezier(.16,1,.3,1), box-shadow .35s ease; }
  .co-btn-primary { background: var(--ink); color: var(--bg-1); }
  .co-btn-primary:hover { color: var(--bg-1); box-shadow: 0 10px 28px color-mix(in srgb, var(--ink) 30%, transparent); }
  .co-btn-ghost { background: transparent; color: var(--ink); border-color: color-mix(in srgb, var(--ink) 25%, transparent); }
  .co-btn-ghost:hover { border-color: var(--ink); }

  .co-hero { padding: 88px 48px 40px; text-align: center; }
  .co-hero h1 { font-size: clamp(34px,5vw,60px); line-height: 1.08; margin: 18px auto 22px; max-width: 820px; }
  .co-hero h1 .accent { color: var(--teal); }
  .co-hero p.lede { max-width: 600px; margin: 0 auto; font-size: 17px; color: var(--ink-soft); }
  .co-hero-cta { display: flex; gap: 16px; justify-content: center; margin-top: 32px; flex-wrap: wrap; }

  .co-coast { max-width: 1100px; margin: 64px auto 0; position: relative; }
  .co-coast svg { width: 100%; height: auto; display: block; }
  .co-coast-path { fill: none; stroke: var(--ink); stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 1000; stroke-dashoffset: 1000; transition: stroke-dashoffset 2.2s cubic-bezier(.16,1,.3,1); }
  .co-coast.drawn .co-coast-path { stroke-dashoffset: 0; }
  .co-signal { position: absolute; width: 10px; height: 10px; border-radius: 50%; background: var(--teal); opacity: 0; transform: scale(0.4); transition: opacity .5s ease, transform .5s ease; }
  .co-coast.drawn .co-signal { opacity: 1; transform: scale(1); }
  .co-signal::after { content: ''; position: absolute; inset: -6px; border-radius: 50%; border: 1px solid var(--teal); animation: pulseRing 2.4s ease-out infinite; }
  @keyframes pulseRing { 0% { transform: scale(0.6); opacity: 0.7; } 100% { transform: scale(2.4); opacity: 0; } }

  .theme-v3 .reveal { opacity: 0; transform: translateY(24px); transition: opacity .8s cubic-bezier(.16,1,.3,1), transform .8s cubic-bezier(.16,1,.3,1); }
  .theme-v3 .reveal.in-view { opacity: 1; transform: translateY(0); }
  .theme-v3 .stagger .reveal:nth-child(1){transition-delay:.02s}
  .theme-v3 .stagger .reveal:nth-child(2){transition-delay:.10s}
  .theme-v3 .stagger .reveal:nth-child(3){transition-delay:.18s}
  .theme-v3 .stagger .reveal:nth-child(4){transition-delay:.26s}
  .theme-v3 .stagger .reveal:nth-child(5){transition-delay:.34s}
  .theme-v3 .stagger .reveal:nth-child(6){transition-delay:.42s}

  .co-section { padding: 100px 48px; }
  .co-head { max-width: 640px; margin: 0 auto 52px; text-align: center; }
  .co-head h2 { font-size: clamp(27px,3.3vw,38px); margin-top: 14px; line-height: 1.18; }

  .co-scrolly { display: grid; grid-template-columns: 0.95fr 1.05fr; gap: 56px; }
  .co-sticky { position: sticky; top: 108px; align-self: start; height: 300px; display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .co-mark-ring { position: relative; width: 230px; height: 230px; }
  .co-mark-ring svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .co-mark-ring circle { fill: none; stroke: var(--border); stroke-width: 1.5; transition: stroke .4s ease, opacity .4s ease, stroke-width .4s ease; }
  .co-mark-ring circle.active { stroke: var(--teal); stroke-width: 2.5; }
  .co-mark-ring img { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); }
  .co-caption { position: relative; width: 280px; min-height: 40px; margin-top: 20px; text-align: center; }
  .co-caption span { position: absolute; inset: 0; display: flex; align-items: flex-start; justify-content: center; opacity: 0; transition: opacity .5s ease; font-family: 'Archivo',sans-serif; font-weight: 800; font-size: 13px; line-height: 1.35; color: var(--ink); }
  .co-caption span.active { opacity: 1; }
  .co-chapters { display: flex; flex-direction: column; }
  .co-chapter { min-height: 300px; display: flex; flex-direction: column; justify-content: center; padding: 24px 0; }
  .co-chapter .idx { font-family: 'Archivo',sans-serif; font-weight: 900; font-size: 13px; color: var(--teal); margin-bottom: 10px; }
  .co-chapter h3 { font-size: 22px; margin-bottom: 12px; }
  .co-chapter p { font-size: 15.5px; color: var(--ink-soft); max-width: 420px; }

  .co-deliver-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 20px; }
  .co-deliver-card { background: var(--surface); border: 1px solid var(--border); border-radius: 18px; padding: 28px 24px; box-shadow: var(--card-shadow); }
  .co-deliver-card .tag { display: inline-block; font-family: 'Archivo',sans-serif; font-weight: 800; font-size: 11px; letter-spacing: 0.08em; color: var(--bg-1); background: var(--ink); border-radius: 999px; padding: 5px 12px; margin-bottom: 16px; }
  .co-deliver-card h3 { font-size: 17px; margin-bottom: 8px; }
  .co-deliver-card p { font-size: 13.5px; color: var(--ink-soft); }

  .co-process { display: flex; gap: 18px; flex-wrap: wrap; justify-content: center; }
  .co-pstep { flex: 1; min-width: 200px; text-align: left; border-left: 2px solid var(--border); padding-left: 18px; }
  .co-pstep b { display: block; font-family: 'Archivo',sans-serif; font-weight: 900; font-size: 14px; margin-bottom: 6px; }
  .co-pstep p { font-size: 13px; color: var(--ink-soft); }

  .co-pins { display: flex; flex-wrap: wrap; gap: 14px; justify-content: center; }
  .co-pin { display: flex; align-items: center; gap: 9px; background: var(--surface); border: 1px solid var(--border); border-radius: 999px; padding: 11px 18px 11px 12px; box-shadow: var(--card-shadow); transition: transform .3s cubic-bezier(.16,1,.3,1); }
  .co-pin:hover { transform: translateY(-4px); }
  .co-pin svg { width: 18px; height: 18px; color: var(--teal); flex: none; }
  .co-pin span { font-size: 13.5px; font-weight: 700; }

  .co-about { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .co-about p { font-size: 15.5px; color: var(--ink-soft); margin-top: 14px; }
  .co-pillars { display: flex; gap: 26px; margin-top: 28px; }
  .co-pillar span { display: block; font-family: 'Archivo',sans-serif; font-weight: 900; font-size: 12.5px; letter-spacing: 0.06em; }
  .co-map2 { position: relative; aspect-ratio: 4/3; border-radius: 24px; background: linear-gradient(160deg, var(--map-bg-1), var(--map-bg-2)); overflow: hidden; display: flex; align-items: center; justify-content: center; }
  .co-map2 img { animation: mfloat 7s ease-in-out infinite; filter: drop-shadow(0 20px 30px rgba(0,0,0,0.3)); }
  @keyframes mfloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }

  .co-cta { padding: 80px 48px; background: var(--teal); }
  .co-cta-inner { max-width: 1180px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 48px; }
  .co-cta-copy { max-width: 620px; }
  .co-cta h2 { font-size: clamp(26px,3.1vw,38px); margin-top: 12px; line-height: 1.18; color: #08110b; }
  .co-cta :global(.natura-contact-email) { color: #08110b; flex: none; }

  .co-footer { background: var(--ink); color: color-mix(in srgb, var(--bg-1) 75%, transparent); padding: 60px 48px 90px; }
  .co-footer-top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 24px; padding-bottom: 32px; border-bottom: 1px solid color-mix(in srgb, var(--bg-1) 12%, transparent); }
  .co-footer-brand { display: flex; align-items: center; gap: 10px; }
  .co-footer-brand span { font-family: 'Archivo',sans-serif; font-weight: 900; color: var(--bg-1); font-size: 13.5px; }
  .co-footer-links { display: flex; gap: 26px; flex-wrap: wrap; }
  .co-footer .co-footer-links a { color: color-mix(in srgb, var(--bg-1) 68%, transparent); font-size: 13.5px; }
  .co-footer .co-footer-links a:hover { color: var(--teal); }
  .co-footer-bottom { display: flex; justify-content: space-between; padding-top: 22px; font-size: 12.5px; flex-wrap: wrap; gap: 8px; }

  @media (max-width: 900px) {
    .co-scrolly { grid-template-columns: 1fr; }
    .co-sticky { position: relative; top: 0; height: auto; padding: 20px 0 40px; }
    .co-deliver-grid { grid-template-columns: 1fr; }
    .co-about { grid-template-columns: 1fr; }
    .co-cta-inner { flex-direction: column; align-items: flex-start; gap: 24px; }
    .co-wrap, .co-section, .co-hero { padding-left: 22px; padding-right: 22px; }
    .co-nav { padding: 14px 16px; }
    .co-nav-tools { gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
    .co-btn { padding: 11px 18px; font-size: 13px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-v3 * { animation: none !important; transition: none !important; }
    .theme-v3 .reveal { opacity: 1; transform: none; }
    .co-coast-path { stroke-dashoffset: 0 !important; }
    .co-signal { opacity: 1 !important; transform: scale(1) !important; }
  }
</style>

<script>
  import { initCommonInteractions } from '../../scripts/common-interactions';
  const page = document.getElementById('main');
  if (page) {
    initCommonInteractions(page);

    const coast = page.querySelector('[data-draw-trigger]');
    if (coast) {
      const io0 = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              coast.classList.add('drawn');
              io0.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.4 },
      );
      io0.observe(coast);
    }

    const chapters = Array.from(page.querySelectorAll('[data-chapter]'));
    const rings = Array.from(page.querySelectorAll('[data-ring]'));
    const caps = Array.from(page.querySelectorAll('[data-cap]'));
    const setActive = (idx: string) => {
      rings.forEach((r) => r.classList.toggle('active', r.getAttribute('data-ring') === idx));
      caps.forEach((cEl) => cEl.classList.toggle('active', cEl.getAttribute('data-cap') === idx));
    };
    if (chapters.length) {
      setActive('0');
      // Track each chapter's own intersection ratio rather than reacting to
      // whichever entry happens to arrive last in a batch — with chapters
      // shorter than the viewport, two can cross the threshold in the same
      // tick, and picking "last in the array" desyncs the active ring/caption
      // from what's actually most visible.
      const ratios = new Map<Element, number>(chapters.map((el) => [el, 0]));
      const io1 = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) ratios.set(entry.target, entry.intersectionRatio);
          let best: Element | null = null;
          let bestRatio = 0;
          for (const el of chapters) {
            const r = ratios.get(el) ?? 0;
            if (r > bestRatio) {
              bestRatio = r;
              best = el;
            }
          }
          if (best) setActive(best.getAttribute('data-chapter') ?? '0');
        },
        { threshold: [0, 0.25, 0.5, 0.75, 1] },
      );
      chapters.forEach((chEl) => io1.observe(chEl));
    }
  }
</script>
