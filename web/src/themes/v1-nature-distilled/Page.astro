    .nd-logo-list { grid-template-columns: 1fr; }
    .nd-logo-card { height: 100px; padding: 16px 44px; }
    .nd-collab-cta { height: auto; }
    .nd-about { grid-template-columns: 1fr; }
    .nd-cta-inner { flex-direction: column; align-items: flex-start; gap: 24px; }
    .nd-wrap, .nd-section, .nd-hero, .nd-problem { padding-left: 24px; padding-right: 24px; }
    /* Móvil: el top bar se pliega como acordeón (logo + botón Menú). */
    .nd-nav { padding: 14px 16px; flex-wrap: wrap; }
    .nd-nav.is-open { background: color-mix(in srgb, var(--bg) 96%, transparent); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); box-shadow: 0 1px 0 var(--border); }
    .nd-brand { flex: 1; min-width: 0; }
    .nd-brand .word { font-size: 13px; }
    .nd-nav-toggle { flex: none; margin-left: 12px; display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 999px; cursor: pointer;
      border: 1px solid color-mix(in srgb, var(--ink) 22%, transparent); background: transparent; color: var(--ink);
      font-family: 'Archivo', Arial, sans-serif; font-weight: 800; font-size: 13px; }
    .nd-nav-toggle svg { width: 16px; height: 16px; transition: transform .35s cubic-bezier(.16,1,.3,1); }
    .nd-nav.is-open .nd-nav-toggle svg { transform: rotate(180deg); }
    .nd-nav-drawer { display: grid; grid-template-rows: 0fr; width: 100%; transition: grid-template-rows .4s cubic-bezier(.16,1,.3,1); }
