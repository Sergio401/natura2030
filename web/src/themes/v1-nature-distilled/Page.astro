---
import { Image } from 'astro:assets';
import isotipoColor from '../../assets/brand/isotipo-color.png';
import monitoringImg from '../../assets/landing/manglar-gopro-velocidad.jpg';
import teamImg from '../../assets/landing/equipo-ala.jpg';
import ThemeToggle from '../../components/shared/ThemeToggle.astro';
import LanguageSwitcher from '../../components/shared/LanguageSwitcher.astro';
import ContactEmail from '../../components/shared/ContactEmail.astro';
import { getContent } from '../../data';
import { collaborators } from '../../data/collaborators';
import type { Locale } from '../../data/types';
import { parseHeadline } from '../../utils/headline';
import './tokens.css';
import { v1Copy } from './copy';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
const c = v1Copy[locale];
const platformHref = locale === 'en' ? '/platform/en/' : '/platform/';
const modelsHref = locale === 'en' ? '/models/en/' : '/models/';
const headlineLines = parseHeadline(c.hero.headline);
let wordIndex = 0;
---

<div class="theme-v1" id="main">
  <header class="nd-nav" data-natura-nav>
    <div class="nd-brand">
      <Image src={isotipoColor} alt="Adaptation Latin America" width={34} height={34} />
      <span class="word">{t.meta.orgName.toUpperCase()}</span>
    </div>
    <button type="button" class="nd-nav-toggle" aria-expanded="false" aria-controls="nd-nav-drawer" data-nav-toggle>
      <span>{c.nav.menu}</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
    </button>
    <div class="nd-nav-drawer" id="nd-nav-drawer">
      <div class="nd-nav-tools">
        <div class="nd-nav-contact">
          <ContactEmail email={t.footer.email} copyLabel={t.ui.copyEmail} copiedLabel={t.ui.emailCopied} compact />
        </div>
        <LanguageSwitcher locale={locale} label={t.ui.languageLabel} />
        <ThemeToggle labelToLight={t.ui.themeToggleToLight} labelToDark={t.ui.themeToggleToDark} />
        <a href={platformHref} class="nd-btn nd-btn-ghost">{t.cta.initiatives}</a>
        <a href={modelsHref} class="nd-btn nd-btn-primary">{t.cta.models}</a>
      </div>
    </div>
  </header>

  <aside class="nd-rail" data-nd-rail aria-label={c.rail.label} inert>
    <a href="#main" class="nd-rail-item nd-rail-brand" style="--i:0" aria-label={c.rail.backToTop}>
      <Image src={isotipoColor} alt="" width={28} height={28} />
      <span class="nd-rail-tip" aria-hidden="true">{c.rail.backToTop}</span>
    </a>
    <span class="nd-rail-sep" aria-hidden="true"></span>
    <a href={platformHref} class="nd-rail-item nd-rail-btn" style="--i:1" aria-label={t.cta.initiatives}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4 3 6.5v13.5L9 17.5l6 2.5 6-2.5V4l-6 2.5z"/><path d="M9 4v13.5M15 6.5V20"/></svg>
      <span class="nd-rail-tip" aria-hidden="true">{t.cta.initiatives}</span>
    </a>
    <a href={modelsHref} class="nd-rail-item nd-rail-btn is-primary" style="--i:2" aria-label={t.cta.models}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 20h18"/><path d="m4 15 5-5 4 3 7-7"/><path d="M15 6h5v5"/></svg>
      <span class="nd-rail-tip" aria-hidden="true">{t.cta.models}</span>
    </a>
    <span class="nd-rail-sep" aria-hidden="true"></span>
    <button type="button" class="nd-rail-item nd-rail-btn" style="--i:3" data-copy-email={t.footer.email} data-label-copied={t.ui.emailCopied} aria-label={`${t.ui.copyEmail}: ${t.footer.email}`}>
      <svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"/></svg>
      <svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12l5 5L20 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <span class="nd-rail-tip" aria-hidden="true" data-copy-text>{t.footer.email}</span>
    </button>
    <div class="natura-lang nd-rail-item" style="--i:4">
      <a href={locale === 'es' ? '/en/' : '/'} class="nd-rail-btn nd-rail-lang" hreflang={locale === 'es' ? 'en' : 'es'} aria-label={c.rail.otherLanguage}>{locale === 'es' ? 'EN' : 'ES'}</a>
      <span class="nd-rail-tip" aria-hidden="true">{c.rail.otherLanguage}</span>
    </div>
    <div class="nd-rail-item nd-rail-theme" style="--i:5">
      <ThemeToggle labelToLight={t.ui.themeToggleToLight} labelToDark={t.ui.themeToggleToDark} />
    </div>
  </aside>

  <section class="nd-hero">
    <div class="nd-hero-waves" aria-hidden="true">
      <svg class="w1" viewBox="0 0 800 400" fill="none"><path d="M0 220C120 160 200 280 320 220C440 160 520 280 640 220C700 190 760 200 800 220" stroke="var(--ink)" stroke-width="3"/><path d="M0 280C120 220 200 340 320 280C440 220 520 340 640 280C700 250 760 260 800 280" stroke="var(--teal)" stroke-width="3"/></svg>
      <svg class="w2" viewBox="0 0 800 400" fill="none"><path d="M0 140C120 200 200 80 320 140C440 200 520 80 640 140C700 170 760 160 800 140" stroke="var(--yellow)" stroke-width="4"/></svg>
    </div>
    <div class="nd-hero-inner">
      <span class="nd-eyebrow nd-hero-eyebrow">{c.hero.eyebrow}</span>
      <h1>
        {headlineLines.map((line, li) => (
          <>
            {line.map((w) => {
              wordIndex += 1;
              return (
                <>
                  {w.spaceBefore && ' '}
                  <span class:list={["w", { accent: w.accent }]} style={`animation-delay:${(wordIndex * 0.05).toFixed(2)}s`}>{w.text}</span>
                </>
              );
            })}
            {li < headlineLines.length - 1 && <br />}
          </>
        ))}
      </h1>
      <p class="lede">{c.hero.lede}</p>
      <div class="nd-hero-cta">
        <a href={platformHref} class="nd-btn nd-btn-ghost">{t.cta.initiatives}</a>
        <a href={modelsHref} class="nd-btn nd-btn-primary magnetic">{t.cta.models}</a>
      </div>
      <div class="nd-hero-contact">
        <span class="nd-hero-contact-label">{c.hero.contactLabel}</span>
        <ContactEmail email={t.footer.email} copyLabel={t.ui.copyEmail} copiedLabel={t.ui.emailCopied} compact />
      </div>
      <div class="nd-scrollcue" aria-hidden="true"><span></span></div>
    </div>
  </section>

  <div class="nd-divider" aria-hidden="true">
    <svg viewBox="0 0 1440 96" preserveAspectRatio="none">
      <g class="nd-divider-track">
        <path d="M0,48 C120,78 240,18 360,48 C480,78 600,18 720,48 C840,78 960,18 1080,48 C1200,78 1320,18 1440,48 V110 H0 Z" fill="var(--block-bg)"/>
        <path d="M1440,48 C1560,78 1680,18 1800,48 C1920,78 2040,18 2160,48 C2280,78 2400,18 2520,48 C2640,78 2760,18 2880,48 V110 H1440 Z" fill="var(--block-bg)"/>
      </g>
    </svg>
  </div>

  <section class="nd-problem">
    <div class="nd-wrap">
      <span class="nd-eyebrow">{c.problem.eyebrow}</span>
      <h2>{c.problem.title}</h2>
      <p>{c.problem.body}</p>
      <div class="nd-chiprow">
        {c.problem.chips.map((chip) => (
          <span class="nd-chip-wrap">
            <button type="button" class="nd-chip">{chip.label}</button>
            <span class="nd-chip-pop" role="tooltip">{chip.description}</span>
          </span>
        ))}
      </div>
    </div>
  </section>

  <section class="nd-section nd-deliver" id="natura2030">
    <div class="nd-wrap">
      <div class="nd-head">
        <span class="nd-eyebrow">{c.sections.deliverables.eyebrow}</span>
        <h2>{c.sections.deliverables.title}</h2>
      </div>
      <div class="nd-deliver-grid stagger">
        {t.deliverables.items.map((item) => (
          <div class="nd-deliver-card reveal">
            <span class="tag">{item.tag}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
      <div class="nd-monitor reveal">
        <div class="nd-monitor-media">
          <Image src={monitoringImg} alt={t.deliverables.monitoring.imageAlt} width={724} height={543} />
        </div>
        <div class="nd-monitor-text">
          <span class="nd-eyebrow">{t.deliverables.monitoring.label}</span>
          <h3>{t.deliverables.monitoring.title}</h3>
          <p>{t.deliverables.monitoring.body}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="nd-section nd-process" id="plataforma">
    <div class="nd-wrap">
      <div class="nd-head">
        <span class="nd-eyebrow">{c.sections.inputs.eyebrow}</span>
        <h2>{c.sections.inputs.title}</h2>
      </div>
      <div class="nd-inputs-grid stagger">
        {t.inputs.items.map((item) => (
          <div class="nd-card reveal">
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </div>
        ))}
      </div>
      <div class="nd-marquee" aria-hidden="true">
        <div class="nd-marquee-track">
          {[...t.inputs.sources, ...t.inputs.sources].map((s) => <span>{s}</span>)}
        </div>
      </div>
    </div>
  </section>

  <section class="nd-section nd-collab" id="colaboradores">
    <div class="nd-wrap nd-collab-grid">
      <div class="nd-collab-copy">
        <span class="nd-eyebrow">{c.sections.collaborators.eyebrow}</span>
        <h2>{c.sections.collaborators.title}</h2>
        <p>{t.collaborators.body}</p>
      </div>
      <ul class="nd-logo-list stagger">
        {collaborators.map((co) => (
          <li class="reveal">
            <a class="nd-logo-card" href={co.url[locale]} target="_blank" rel="noopener noreferrer">
              <Image src={co.logo} alt={co.name} height={120} />
              <svg class="nd-logo-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>
            </a>
          </li>
        ))}
        <li class="reveal">
          <button type="button" class="nd-collab-cta" data-copy-email={t.footer.email} data-label-copied={t.ui.emailCopied} aria-label={`${t.ui.copyEmail}: ${t.footer.email}`}>
            <strong>{c.sections.collaborators.ctaTitle}</strong>
            <span class="nd-collab-cta-line">
              <span data-copy-text>{t.footer.email}</span>
              <svg class="icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V5a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v10a1 1 0 0 0 1 1h3"/></svg>
              <svg class="icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12l5 5L20 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </button>
        </li>
      </ul>
    </div>
  </section>

  <section class="nd-section nd-people" id="nosotros">
    <div class="nd-wrap nd-about">
      <div class="nd-about-copy">
        <span class="nd-eyebrow">{c.sections.about.eyebrow}</span>
        <h2>{c.sections.about.title}</h2>
        <p>{t.about.body}</p>
        <div class="nd-pillars">
          {t.about.pillars.map((p) => <div class="nd-pillar"><span>{p}</span></div>)}
        </div>
      </div>
      <div class="nd-team reveal">
        <Image src={teamImg} alt={t.about.imageAlt} widths={[560, 1120]} sizes="(max-width: 860px) 100vw, 540px" />
      </div>
    </div>
  </section>

  <section class="nd-cta" id="cta">
    <div class="nd-cta-inner">
      <div class="nd-cta-copy">
        <span class="nd-eyebrow" style="color:var(--ink);">{c.sections.cta.eyebrow}</span>
        <h2>{c.sections.cta.title}</h2>
      </div>
      <ContactEmail email={t.footer.email} copyLabel={t.ui.copyEmail} copiedLabel={t.ui.emailCopied} />
    </div>
  </section>

  <footer class="nd-footer">
    <div class="nd-footer-top">
      <div class="nd-footer-brand"><Image src={isotipoColor} alt="" width={24} height={24} /><span>{t.meta.orgName}</span></div>
      <div class="nd-footer-links">
        <a href={`mailto:${t.footer.email}`}>{t.footer.email}</a>
      </div>
    </div>
    <div class="nd-footer-bottom">
      <span>{t.footer.copyright}</span>
      <span>{t.footer.note}</span>
    </div>
  </footer>

</div>

<style>
  .theme-v1 {
    margin: 0;
    font-family: Arial, Helvetica, sans-serif;
    color: var(--ink);
    background: var(--bg);
    width: 100%;
    position: relative;
  }
  .theme-v1 * { box-sizing: border-box; }
  .theme-v1 h1, .theme-v1 h2, .theme-v1 h3 { font-family: 'Archivo', Arial, sans-serif; font-weight: 900; margin: 0; letter-spacing: -0.01em; }
  .theme-v1 p { margin: 0; line-height: 1.6; }
  .theme-v1 a:not(.nd-btn) { color: var(--ink); text-decoration: none; }
  .theme-v1 a:not(.nd-btn):hover { color: var(--teal); }
  .nd-eyebrow { font-family: 'Archivo', Arial, sans-serif; font-weight: 800; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--teal); }
  .nd-wrap { max-width: 1180px; margin: 0 auto; padding: 0 48px; }

  .nd-nav { position: sticky; top: var(--dev-banner-h, 0px); z-index: 40; display: flex; align-items: center; justify-content: space-between;
    padding: 18px 48px; background: transparent;
    transition: background .3s ease, backdrop-filter .3s ease; }
  .nd-nav.scrolled { background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); box-shadow: 0 1px 0 var(--border); }
  .nd-nav { transition: background .3s ease, backdrop-filter .3s ease, transform .5s cubic-bezier(.16,1,.3,1), opacity .35s ease; }

  /* Rail lateral: reemplaza al top bar cuando el hero sale de pantalla (solo escritorio). */
  .nd-rail { position: fixed; right: 14px; top: 50%; z-index: 45; display: none; flex-direction: column; align-items: center; gap: 4px;
    padding: 8px 5px; background: color-mix(in srgb, var(--surface) 38%, transparent); border: 1px solid color-mix(in srgb, var(--ink) 7%, transparent); border-radius: 999px;
    box-shadow: 0 8px 24px color-mix(in srgb, var(--ink) 7%, transparent); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    transform: translate(calc(100% + 24px), -50%); opacity: 0; pointer-events: none;
    transition: transform .55s cubic-bezier(.16,1,.3,1), opacity .35s ease; }
  .nd-rail-item { position: relative; display: flex; align-items: center; justify-content: center;
    opacity: 0; transform: translateX(10px); transition: opacity .3s ease, transform .45s cubic-bezier(.16,1,.3,1); }
  .theme-v1.is-rail .nd-rail { transform: translate(0, -50%); opacity: .7; pointer-events: auto; }
  .theme-v1.is-rail .nd-rail:hover, .theme-v1.is-rail .nd-rail:focus-within { opacity: 1; }
  .theme-v1.is-rail .nd-rail-item { opacity: 1; transform: none; transition-delay: calc(.12s + var(--i) * .05s); }
  .nd-rail-brand { padding: 2px; }
  .nd-rail-brand img { display: block; border-radius: 50%; }
  .nd-rail-sep { width: 14px; height: 1px; margin: 2px 0; background: color-mix(in srgb, var(--ink) 10%, transparent); }
  .nd-rail-btn { width: 32px; height: 32px; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center;
    border: none; background: transparent; color: color-mix(in srgb, var(--ink) 72%, transparent); cursor: pointer; padding: 0;
    font-family: 'Archivo', Arial, sans-serif; font-weight: 800; font-size: 11px; letter-spacing: .04em; text-decoration: none;
    transition: background .2s ease, color .2s ease; }
  .nd-rail-btn:hover { background: color-mix(in srgb, var(--ink) 8%, transparent); }
  .theme-v1 .nd-rail a.nd-rail-btn { color: color-mix(in srgb, var(--ink) 72%, transparent); }
  .theme-v1 .nd-rail a.nd-rail-btn:hover, .nd-rail-btn:hover { color: var(--ink); }
  .theme-v1 .nd-rail a.nd-rail-btn.is-primary { color: var(--teal); }
  .nd-rail-btn svg { width: 16px; height: 16px; }
  .nd-rail-btn .icon-check, .nd-rail-btn.copied .icon-copy { display: none; }
  .nd-rail-btn.copied .icon-check { display: block; color: var(--teal); }
  .nd-rail-theme :global(.natura-theme-toggle) { width: 32px; height: 32px; border: none; opacity: .72; }
  .nd-rail-theme :global(.natura-theme-toggle:hover) { opacity: 1; background: color-mix(in srgb, var(--ink) 8%, transparent); }
  .nd-rail-theme :global(.natura-theme-toggle svg) { width: 16px; height: 16px; }
  /* Sobre paneles oscuros (--block-bg) el rail cambia a tinta clara. */
  .nd-rail.on-dark { background: color-mix(in srgb, var(--block-ink) 8%, transparent); border-color: color-mix(in srgb, var(--block-ink) 14%, transparent);
    box-shadow: none; }
  .nd-rail.on-dark .nd-rail-btn, .theme-v1 .nd-rail.on-dark a.nd-rail-btn { color: color-mix(in srgb, var(--block-ink) 75%, transparent); }
  .nd-rail.on-dark .nd-rail-btn:hover, .theme-v1 .nd-rail.on-dark a.nd-rail-btn:hover { color: var(--block-ink); background: color-mix(in srgb, var(--block-ink) 12%, transparent); }
  .theme-v1 .nd-rail.on-dark a.nd-rail-btn.is-primary { color: var(--teal); }
  .nd-rail.on-dark .nd-rail-sep { background: color-mix(in srgb, var(--block-ink) 16%, transparent); }
  .nd-rail.on-dark .nd-rail-theme :global(.natura-theme-toggle) { color: var(--block-ink); }
  .nd-rail { transition: transform .55s cubic-bezier(.16,1,.3,1), opacity .35s ease, background .3s ease, border-color .3s ease; }
  .nd-rail-tip { position: absolute; right: calc(100% + 14px); top: 50%; transform: translate(6px, -50%); white-space: nowrap; pointer-events: none;
    background: var(--surface); color: var(--ink); border: 1px solid var(--border); box-shadow: 0 8px 22px color-mix(in srgb, var(--ink) 18%, transparent); font-family: Arial, Helvetica, sans-serif; font-size: 12px; font-weight: 700; letter-spacing: 0; padding: 6px 10px; border-radius: 8px;
    opacity: 0; transition: opacity .2s ease, transform .2s ease; }
  .nd-rail-item:hover .nd-rail-tip, .nd-rail-item:focus-within .nd-rail-tip, .nd-rail-item:focus-visible .nd-rail-tip, .nd-rail-btn.copied .nd-rail-tip { opacity: 1; transform: translate(0, -50%); }
  @media (min-width: 861px) {
    .nd-rail { display: flex; }
    .theme-v1.is-rail .nd-nav { transform: translateY(-110%); opacity: 0; pointer-events: none; }
  }
  .nd-brand { display: flex; align-items: center; gap: 10px; }
  .nd-brand img { display: block; }
  .nd-brand .word { font-family: 'Archivo', Arial, sans-serif; font-weight: 900; font-size: 15px; line-height: 1.15; }
  .nd-brand .word small { display: block; font-weight: 600; font-size: 10px; letter-spacing: 0.16em; color: var(--teal); }
  .nd-nav-tools { display: flex; align-items: center; gap: 16px; }
  .nd-nav-drawer { display: contents; }
  .nd-nav-toggle { display: none; }
  .nd-nav-contact { display: flex; align-items: center; padding-right: 12px; border-right: 1px solid color-mix(in srgb, var(--ink) 18%, transparent); }
  .nd-btn { font-family: 'Archivo', Arial, sans-serif; font-weight: 800; font-size: 14px; border-radius: 999px; padding: 13px 26px;
    display: inline-flex; align-items: center; gap: 8px; border: 2px solid transparent; cursor: pointer; text-decoration: none;
    transition: transform .35s cubic-bezier(.16,1,.3,1), box-shadow .35s ease; }
  .nd-btn-primary { background: var(--teal); color: #0b1626; }
  .nd-btn-primary:hover { color: #0b1626; box-shadow: 0 10px 28px color-mix(in srgb, var(--teal) 40%, transparent); }
  .nd-btn-ghost { background: transparent; color: var(--ink); border-color: color-mix(in srgb, var(--ink) 25%, transparent); }
  .nd-btn-ghost:hover { color: var(--ink); border-color: var(--ink); }

  .nd-hero { position: relative; padding: 96px 48px 4px; overflow: hidden; }
  .nd-hero-waves { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .nd-hero-waves svg { position: absolute; width: 140%; max-width: 1600px; opacity: 0.16; }
  .nd-hero-waves .w1 { top: -60px; left: -140px; animation: driftA 30s ease-in-out infinite; }
  .nd-hero-waves .w2 { bottom: -120px; right: -160px; opacity: 0.12; animation: driftB 38s ease-in-out infinite; }
  @keyframes driftA { 0%,100% { transform: translate(0,0); } 50% { transform: translate(100px,50px); } }
  @keyframes driftB { 0%,100% { transform: translate(0,0); } 50% { transform: translate(-110px,-36px); } }
  .nd-hero-inner { position: relative; z-index: 1; max-width: 1180px; margin: 0 auto; text-align: center; }
  .nd-hero-eyebrow { display: inline-block; opacity: 0; transform: translateY(14px); animation: riseWord .8s cubic-bezier(.16,1,.3,1) forwards; }
  .nd-hero h1 { font-size: clamp(38px,5.4vw,68px); line-height: 1.06; margin: 20px 0 26px; }
  .nd-hero h1 .w { display: inline-block; opacity: 0; transform: translateY(18px); animation: riseWord .8s cubic-bezier(.16,1,.3,1) forwards; }
  .nd-hero h1 .w.accent { color: var(--teal); }
  @keyframes riseWord { to { opacity: 1; transform: translateY(0); } }
  .nd-hero p.lede { max-width: 640px; margin: 0 auto; font-size: 18px; color: var(--ink-soft); }
  .nd-hero-cta { display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 38px; flex-wrap: wrap; }
  .nd-hero-contact { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 24px; flex-wrap: wrap; }
