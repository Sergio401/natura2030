</style>

<script>
  import { initCommonInteractions } from '../../scripts/common-interactions';
  const page = document.getElementById('main');
  if (page) initCommonInteractions(page);

  // Móvil: acordeón del top bar.
  const navToggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  navToggle?.addEventListener('click', () => {
    const open = navToggle.getAttribute('aria-expanded') !== 'true';
    navToggle.setAttribute('aria-expanded', String(open));
    navToggle.closest('.nd-nav')?.classList.toggle('is-open', open);
  });

  // Top bar ↔ rail lateral: mientras el hero está en pantalla se muestra el top bar;
  // al salir, el top bar se esconde y entra el rail (en móvil el CSS nunca muestra el rail).
  const hero = document.querySelector('.nd-hero');
  const nav = document.querySelector<HTMLElement>('[data-natura-nav]');
  const rail = document.querySelector<HTMLElement>('[data-nd-rail]');
  const desktop = window.matchMedia('(min-width: 861px)');
  if (page && hero && nav && rail) {
    let heroVisible = true;
    const apply = () => {
      const on = desktop.matches && !heroVisible;
      page.classList.toggle('is-rail', on);
      rail.inert = !on;
      nav.inert = on;
    };
    new IntersectionObserver(([entry]) => {
      heroVisible = entry.isIntersecting;
      apply();
    }, { rootMargin: '-120px 0px 0px 0px' }).observe(hero);
    desktop.addEventListener('change', apply);

    // El rail cambia de tinta según el panel que tiene debajo (claro u oscuro).
    const darkBlocks = Array.from(page.querySelectorAll<HTMLElement>('.nd-problem, .nd-process, .nd-people, .nd-footer'));
    let ticking = false;
    const updateTone = () => {
      ticking = false;
      if (!page.classList.contains('is-rail')) return;
      const y = window.innerHeight / 2;
      rail.classList.toggle('on-dark', darkBlocks.some((el) => {
        const r = el.getBoundingClientRect();
        return r.top <= y && r.bottom >= y;
      }));
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(updateTone); }
    }, { passive: true });
    updateTone();
  }

  document.querySelectorAll<HTMLButtonElement>('[data-copy-email]').forEach((btn) => {
    const email = btn.dataset.copyEmail ?? '';
    const text = btn.querySelector<HTMLElement>('[data-copy-text]');
    let timer: number | undefined;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(email);
      } catch {
        return;
      }
      btn.classList.add('copied');
      if (text) text.textContent = btn.dataset.labelCopied ?? '';
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.classList.remove('copied');
        if (text) text.textContent = email;
      }, 2000);
    });
  });
</script>
