---
import { Image } from 'astro:assets';
import 'maplibre-gl/dist/maplibre-gl.css';
import isotipoColor from '../../assets/brand/isotipo-color.png';
import ThemeToggle from '../../components/shared/ThemeToggle.astro';
import { platformLocations } from '../../data/platform-locations';
import { locationMedia } from '../../data/platform-location-media';
import { platformCopy } from '../../data/platform-copy';
import type { Locale } from '../../data/types';
import { ICONS } from './icons';
import './platform.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = platformCopy[locale];
const languageHref = locale === 'es' ? '/platform/en/' : '/platform/';
const siteHref = locale === 'es' ? '/' : '/en/';
const modelsHref = locale === 'es' ? '/models/' : '/models/en/';
const locationCount = String(platformLocations.length).padStart(2, '0');
---

<main class="platform-shell" id="main" data-platform-root data-locale={locale}>
  <header class="platform-header">
    <a class="platform-brand" href={siteHref} aria-label={copy.header.back}>
      <Image src={isotipoColor} alt="" width={30} height={30} />
      <span class="platform-brand-copy">
        <strong>ADAPTATION LATIN AMERICA</strong>
        <small>{copy.header.eyebrow}</small>
      </span>
    </a>

    <div class="platform-title" aria-hidden="true">
      <span class="platform-pulse"></span>
      <span>{copy.header.title}</span>
    </div>

    <div class="platform-header-tools">
      <span class="platform-status"><span class="platform-pulse"></span>{copy.header.status}</span>
      <a class="platform-language" href={languageHref}>{copy.header.language}</a>
      <ThemeToggle
        labelToLight={locale === 'es' ? 'Cambiar a modo claro' : 'Switch to light mode'}
        labelToDark={locale === 'es' ? 'Cambiar a modo oscuro' : 'Switch to dark mode'}
      />
      <a class="platform-models-link" href={modelsHref}>{copy.header.models}</a>
      <a class="platform-back" href={siteHref}><span aria-hidden="true">←</span>{copy.header.back}</a>
    </div>
  </header>

  <section class="platform-map-region" aria-label={copy.map.ariaLabel}>
    <div class="platform-map" data-platform-map></div>

    <div class="platform-map-summary" aria-hidden="true">
      <strong>{locationCount}</strong>
      <span>{copy.map.locationCountLabel}</span>
    </div>

    <div class="platform-map-toolbar" aria-label={copy.map.ariaLabel}>
      <div class="platform-style-switch" role="group" aria-label={copy.map.ariaLabel}>
        <button type="button" class="is-active" data-map-style="satellite" aria-pressed="true">
          {copy.map.satellite}
        </button>
        <button type="button" data-map-style="streets" aria-pressed="false">
          {copy.map.streets}
        </button>
      </div>
      <button type="button" class="platform-home-button" data-map-home title={copy.map.resetView} aria-label={copy.map.resetView}>
        <span aria-hidden="true">⌖</span>
      </button>
    </div>

    <div class="platform-legend">
      <span class="platform-legend-title">{copy.map.legendTitle}</span>
      {Object.entries(copy.categories).map(([category, label]) => (
        <span class="platform-legend-item">
          <i class={`category-${category}`} aria-hidden="true"></i>{label}
        </span>
      ))}
    </div>

    <div class="platform-map-error" data-map-error hidden>
      <span>{copy.map.loadError}</span>
    </div>
  </section>

  <aside class="platform-panel" data-location-panel aria-hidden="true" aria-labelledby="location-title" inert>
    <button type="button" class="platform-panel-close" data-panel-close aria-label={copy.panel.close}>×</button>
    <div class="platform-panel-body">
      <div class="platform-hero">
        {platformLocations.map((location) => {
          const media = locationMedia[location.id];
          return media && (
            <figure class="platform-hero-figure" data-hero-location={location.id} hidden>
              <Image src={media.image} alt={location.content[locale].heroAlt} width={640} height={360} loading="lazy" />
              <figcaption class="platform-hero-credit">{copy.panel.photoCredit}: {media.credit}</figcaption>
            </figure>
          );
        })}
      </div>

      <div class="platform-location-meta">
        <p class="platform-location-region" data-location-region></p>
        <div class="platform-location-meta-right">
          <span class="platform-location-coords">
            <span class="platform-icon platform-icon-inline" set:html={ICONS.mapPin} />
            <span data-location-coordinates></span>
          </span>
          <button type="button" class="platform-view-map-btn" data-location-view-map>
            <span class="platform-icon platform-icon-inline" set:html={ICONS.compass} />
            {copy.panel.viewOnMap}
          </button>
        </div>
      </div>

      <h1 id="location-title" class="platform-location-title" tabindex="-1" data-location-title></h1>

      <div class="platform-badge-row">
        <span class="platform-badge" data-location-category-badge></span>
        <span class="platform-badge platform-badge-status">
          <span class="platform-pulse"></span><span data-location-status></span>
        </span>
      </div>

      <div class="platform-tabs" role="tablist" aria-label={copy.panel.tabsLabel} data-location-tabs>
        <button type="button" role="tab" id="location-tab-details" aria-controls="location-panel-details" aria-selected="true" data-location-tab="details">
          {copy.panel.tabDetails}
        </button>
        <button type="button" role="tab" id="location-tab-overview" aria-controls="location-panel-overview" aria-selected="false" tabindex="-1" data-location-tab="overview">
          {copy.panel.tabOverview}
        </button>
      </div>

      <div class="platform-tabpanel" role="tabpanel" id="location-panel-details" aria-labelledby="location-tab-details" data-location-tabpanel="details">
        <p class="platform-location-summary" data-location-summary></p>

        <div class="platform-mini-grid" data-location-challenge-block hidden>
          <div class="platform-mini-block platform-mini-block-challenge">
            <span class="platform-mini-label">
              <span class="platform-icon" set:html={ICONS.triangleAlert} />{copy.panel.challenge}
            </span>
            <p data-location-challenge></p>
          </div>
          <div class="platform-mini-block platform-mini-block-response">
            <span class="platform-mini-label">
              <span class="platform-icon" set:html={ICONS.leaf} />{copy.panel.response}
            </span>
            <p data-location-response></p>
          </div>
          <div class="platform-mini-block platform-mini-block-applications">
            <span class="platform-mini-label">
              <span class="platform-icon" set:html={ICONS.grid2x2} />{copy.panel.applications}
            </span>
            <ul data-location-applications></ul>
          </div>
        </div>

        <section class="platform-location-section" data-location-inputs-section>
          <h2>{copy.panel.dataInputs}</h2>
          <ul class="platform-icon-grid" data-location-inputs></ul>
        </section>

        <section class="platform-location-section" data-location-outputs-section>
          <h2>{copy.panel.outputs}</h2>
          <ul class="platform-icon-grid" data-location-outputs></ul>
        </section>
      </div>

      <div class="platform-tabpanel" role="tabpanel" id="location-panel-overview" aria-labelledby="location-tab-overview" data-location-tabpanel="overview" hidden>
        <div class="platform-overview-body" data-overview-body></div>
      </div>

      <div class="platform-collaborate">
        <div class="platform-collaborate-copy">
          <span class="platform-icon platform-icon-collaborate" set:html={ICONS.usersRound} />
          <div>
            <strong>{copy.panel.collaborateTitle}</strong>
            <p>{copy.panel.collaborateBody}</p>
          </div>
        </div>
        <a class="platform-collaborate-cta" data-location-cta href="#">
          {copy.panel.collaborateCta}<span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </aside>

  <div class="platform-mobile-scrim" data-panel-close aria-hidden="true"></div>

  <div class="platform-sr-list" aria-label={copy.map.locationCountLabel}>
    {platformLocations.map((location) => (
      <button type="button" data-location-shortcut={location.id}>
        {location.content[locale].title}
      </button>
    ))}
  </div>
</main>

<script>
  import { initPlatformMap } from './platform-map';

  const roots = document.querySelectorAll<HTMLElement>('[data-platform-root]');
  for (const root of roots) initPlatformMap(root);
</script>
